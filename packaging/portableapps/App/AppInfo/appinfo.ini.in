; PortableApps.com Format 3.5. @PACKAGE_VERSION@ and @DISPLAY_VERSION@ are filled in by make_package.py.
[Format]
Type=PortableApps.comFormat
Version=3.5

[Details]
Name=OSATURA Portable
AppID=OSATURAPortable
Publisher=Alexandru-Ionuț Chiuță (Alexio)
Homepage=github.com/chiuta/osatura
Category=Graphics and Pictures
Description=2D rigging and animation studio and command-line engine (alpha)
Language=Multilingual
Trademarks=OSATURA

[License]
Shareable=true
OpenSource=true
Freeware=true
CommercialUse=true
EULAVersion=1

[Version]
PackageVersion=@PACKAGE_VERSION@
DisplayVersion=@DISPLAY_VERSION@

[SpecialPaths]
Plugins=NONE

[Dependencies]
UsesJava=no
UsesDotNetVersion=
Requires64bit=true

[Control]
Icons=1
Start=OSATURAPortable.exe
